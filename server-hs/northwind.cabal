cabal-version:      3.0
name:               northwind
version:            0.1.0.0
synopsis:           ECC-CRM backend in Haskell
build-type:         Simple

executable northwind
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:
        Types
        JWT
        Password
        DB
        Auth
        Contacts
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
        LambdaCase
        RecordWildCards
        ScopedTypeVariables
    ghc-options:
        -Wall
        -threaded
        -rtsopts
        -with-rtsopts=-N
    build-depends:
        base                >= 4.17 && < 5
      , aeson               >= 2.1  && < 2.3
      , bytestring
      , text
      , scotty              >= 0.20
      , sqlite-simple
      , cryptonite
      , memory
      , base64-bytestring
      , time
      , containers
      , wai-middleware-static
      , http-types
      , directory
      , filepath
      , string-conversions
