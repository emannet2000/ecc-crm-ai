/* ============================================================
   ECC CRM — Flor-inspired dark/gold theme
   Class names mirror the existing Elm views. Nothing renamed.
   ============================================================ */

:root {
  --bg: #000000;
  --bg-elevated: #080808;
  --surface: #0e0e0e;
  --surface-2: #161616;
  --surface-3: #1e1e1e;

  --border: rgba(226, 185, 77, 0.22);
  --border-strong: rgba(226, 185, 77, 0.45);
  --border-soft: rgba(226, 185, 77, 0.10);

  --text: #f5eedc;
  --text-muted: rgba(245, 238, 220, 0.58);
  --text-dim: rgba(245, 238, 220, 0.32);

  --gold: #e2b94d;
  --gold-bright: #f0cf74;
  --gold-soft: #f5df9a;
  --gold-dim: #b8922e;
  --gold-deep: #8a6d1f;

  --gold-glow: rgba(226, 185, 77, 0.18);
  --gold-glow-strong: rgba(226, 185, 77, 0.32);
  --gold-glow-max: rgba(226, 185, 77, 0.5);

  --success: #6bcb8a;
  --danger: #e07070;
  --info: #7eb8d4;

  --radius: 14px;
  --radius-sm: 9px;

  --font-sans: "Hanken Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-serif: Fraunces, Georgia, "Times New Roman", serif;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-weight: 400;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

body {
  background-image:
    radial-gradient(ellipse 90% 55% at 75% -5%, rgba(226, 185, 77, 0.12) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 5% 90%, rgba(226, 185, 77, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse 30% 25% at 50% 50%, rgba(226, 185, 77, 0.03) 0%, transparent 60%);
  background-attachment: fixed;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-serif);
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.02em;
  margin: 0;
}

a { color: var(--gold-bright); text-decoration: none; }
a:hover { color: var(--gold-soft); }

button { font-family: inherit; }
input, select, textarea { font-family: inherit; }

/* ── Motifs (mirrors Flor) ─────────────────────────────────── */

.motif-line {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%, var(--gold) 20%, var(--gold-bright) 50%,
    var(--gold) 80%, transparent 100%);
  opacity: 0.55;
  z-index: 1000;
  pointer-events: none;
}

.motif-orb {
  position: fixed;
  right: -100px; top: -60px;
  width: 580px; height: 580px;
  pointer-events: none;
  z-index: 0;
  opacity: 0.45;
  background:
    radial-gradient(circle at center, transparent 22%, rgba(226,185,77,0.06) 23%, transparent 24%),
    radial-gradient(circle at center, transparent 32%, rgba(226,185,77,0.07) 33%, transparent 34%),
    radial-gradient(circle at center, transparent 42%, rgba(226,185,77,0.08) 43%, transparent 44%),
    radial-gradient(circle at center, transparent 52%, rgba(226,185,77,0.09) 53%, transparent 54%),
    radial-gradient(circle at center, transparent 62%, rgba(226,185,77,0.07) 63%, transparent 64%),
    radial-gradient(circle at center, transparent 72%, rgba(226,185,77,0.05) 73%, transparent 74%),
    radial-gradient(circle at center, transparent 82%, rgba(226,185,77,0.04) 83%, transparent 84%);
}

.motif-dots {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.5;
  background-image: radial-gradient(circle, rgba(226,185,77,0.4) 1px, transparent 1px);
  background-size: 26px 26px;
  -webkit-mask-image: radial-gradient(ellipse 65% 55% at 82% 12%, black 0%, transparent 72%);
  mask-image: radial-gradient(ellipse 65% 55% at 82% 12%, black 0%, transparent 72%);
}

/* ── Root shell ────────────────────────────────────────────── */

.ecc-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.ecc-dashboard {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ecc-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  color: var(--text-muted);
}

.ecc-loading__spinner {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 2px solid var(--border);
  border-top-color: var(--gold-bright);
  animation: eccSpin 0.9s linear infinite;
  box-shadow: 0 0 20px var(--gold-glow);
}

@keyframes eccSpin { to { transform: rotate(360deg); } }

.ecc-loading__text {
  font-size: 0.9rem;
  letter-spacing: 0.04em;
  color: var(--text-muted);
}

/* ── Login / Register split ────────────────────────────────── */

.ecc-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 100vh;
}

.brand-panel {
  position: relative;
  overflow: hidden;
  padding: 56px 64px;
  background: linear-gradient(180deg, rgba(14,12,4,0.85) 0%, rgba(0,0,0,0.95) 100%);
  border-right: 1px solid var(--border);
}

.brand-panel__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}

.brand-panel__glow--1 {
  top: -140px; right: -120px;
  width: 520px; height: 520px;
  background: radial-gradient(circle, rgba(226,185,77,0.14), transparent 70%);
}

.brand-panel__glow--2 {
  bottom: -180px; left: -100px;
  width: 460px; height: 460px;
  background: radial-gradient(circle, rgba(226,185,77,0.08), transparent 70%);
}

.brand-panel__inner {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.brand-panel__header {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-panel__wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.brand-panel__name {
  font-family: var(--font-serif);
  font-weight: 600;
  font-size: 1.4rem;
  color: var(--gold-bright);
  letter-spacing: -0.02em;
  text-shadow: 0 0 24px var(--gold-glow);
}

.brand-panel__product {
  font-size: 0.62rem;
  font-weight: 600;
  color: var(--gold-dim);
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.brand-panel__hero { margin-top: 24px; max-width: 480px; }

.brand-panel__headline {
  font-family: var(--font-serif);
  font-size: 2.6rem;
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: var(--text);
}

.brand-panel__headline-accent {
  color: var(--gold-bright);
  text-shadow: 0 0 40px var(--gold-glow-strong);
}

.brand-panel__lede {
  margin-top: 20px;
  color: var(--text-muted);
  font-size: 0.98rem;
  line-height: 1.6;
  max-width: 420px;
}

.trust-list {
  list-style: none;
  padding: 0;
  margin: auto 0 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.86rem;
  color: var(--text-muted);
}

.trust-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px; height: 22px;
  border-radius: 6px;
  background: var(--gold-glow);
  border: 1px solid var(--border);
  color: var(--gold-bright);
  box-shadow: 0 0 12px var(--gold-glow);
}

.brand-panel__footer {
  font-size: 0.74rem;
  color: var(--text-dim);
  letter-spacing: 0.03em;
}

.auth-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 32px;
  background: transparent;
}

.auth-panel__inner {
  width: 100%;
  max-width: 400px;
}

.auth-header { margin-bottom: 28px; }

.auth-title {
  font-family: var(--font-serif);
  font-size: 1.7rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.025em;
}

.auth-subtitle {
  margin-top: 8px;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.auth-switch {
  margin-top: 20px;
  font-size: 0.86rem;
  color: var(--text-muted);
  text-align: center;
}

.auth-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 32px;
  font-size: 0.74rem;
  color: var(--text-dim);
}

.auth-footer__lock { color: var(--gold-dim); display: inline-flex; }

/* ── App shell ─────────────────────────────────────────────── */

.app-shell {
  display: grid;
  grid-template-columns: 248px 1fr;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.app-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* ── Sidebar ───────────────────────────────────────────────── */

.sidebar {
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--bg-elevated) 0%, #050505 100%);
  border-right: 1px solid var(--border);
  padding: 24px 14px 18px;
  position: sticky;
  top: 0;
  align-self: start;
  height: 100vh;
  overflow-y: auto;
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 8px 22px;
  border-bottom: 1px solid var(--border-soft);
  margin-bottom: 22px;
}

.sidebar__wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.sidebar__name {
  font-family: var(--font-serif);
  font-weight: 600;
  font-size: 1.14rem;
  color: var(--gold-bright);
  letter-spacing: -0.02em;
  text-shadow: 0 0 20px var(--gold-glow);
}

.sidebar__product {
  font-size: 0.58rem;
  font-weight: 600;
  color: var(--gold-dim);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.sidebar__nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 16px;
}

.sidebar__nav--bottom {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid var(--border-soft);
}

.sidebar__section-label {
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--gold-dim);
  padding: 6px 14px 8px;
  font-weight: 600;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 450;
  text-align: left;
  cursor: pointer;
  transition: background 0.18s ease, color 0.18s ease,
              border-color 0.18s ease, box-shadow 0.18s ease;
  position: relative;
}

.nav-item:hover {
  background: var(--gold-glow);
  color: var(--text);
  border-color: var(--border-soft);
}

.nav-item--active {
  background: linear-gradient(135deg, var(--gold-glow-strong) 0%, rgba(226,185,77,0.06) 100%);
  color: var(--gold-bright);
  font-weight: 600;
  border-color: var(--border);
  box-shadow: 0 0 20px var(--gold-glow), inset 0 1px 0 rgba(255,255,255,0.05);
}

.nav-item--active::before {
  content: '';
  position: absolute;
  left: 0; top: 20%; bottom: 20%;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: linear-gradient(180deg, var(--gold-bright), var(--gold));
  box-shadow: 0 0 8px var(--gold-glow-strong);
}

.nav-item__icon {
  display: inline-flex;
  width: 22px;
  justify-content: center;
  color: currentColor;
  opacity: 0.85;
}

.nav-item__label { flex: 1; }

.sidebar__user {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 10px 10px 6px;
  margin-top: 14px;
  border-radius: 28px;
  border: 1px solid var(--border);
  background: linear-gradient(135deg, rgba(226,185,77,0.08) 0%, var(--surface-2) 100%);
  box-shadow: 0 0 20px var(--gold-glow);
}

.sidebar__avatar,
.topbar__avatar {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--gold-soft), var(--gold-dim));
  color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72rem;
  font-weight: 700;
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow: 0 0 0 2px rgba(0,0,0,0.25), 0 0 12px var(--gold-glow);
  flex-shrink: 0;
}

.sidebar__user-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sidebar__user-name {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar__user-email {
  font-size: 0.68rem;
  color: var(--text-dim);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar__signout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 10px;
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
  font-size: 0.8rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.18s ease;
}

.sidebar__signout-btn:hover {
  color: var(--danger);
  border-color: rgba(224,112,112,0.4);
  background: rgba(224,112,112,0.08);
}

/* ── Topbar ────────────────────────────────────────────────── */

.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 64px;
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  background: linear-gradient(180deg, rgba(14,12,4,0.97) 0%, rgba(0,0,0,0.94) 100%);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
  box-shadow:
    0 1px 0 var(--border-soft),
    0 8px 40px rgba(0,0,0,0.55),
    0 0 60px rgba(226,185,77,0.04);
}

.topbar__right { display: flex; align-items: center; gap: 14px; }

/* ── Content area ──────────────────────────────────────────── */

.content {
  flex: 1;
  padding: 32px 36px 48px;
  min-width: 0;
  overflow-x: auto;
}

.content__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28px;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--border-soft);
  position: relative;
}

.content__header::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 120px; height: 1px;
  background: linear-gradient(90deg, var(--gold-bright), transparent);
}

.content__title,
.content__heading {
  font-family: var(--font-serif);
  font-size: 1.85rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.025em;
  line-height: 1.2;
}

.content__lede {
  color: var(--text-muted);
  font-size: 0.92rem;
  margin-top: 6px;
}

.content__body { position: relative; }

.content__section {
  margin-top: 32px;
  padding-top: 22px;
  border-top: 1px solid var(--border-soft);
}

.content__section-title {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  color: var(--gold-bright);
  margin-bottom: 12px;
}

.content__empty,
.content__empty-block {
  padding: 40px 20px;
  text-align: center;
  color: var(--text-dim);
  font-size: 0.9rem;
  border: 1px dashed var(--border);
  border-radius: var(--radius);
  background: rgba(226,185,77,0.02);
}

/* ── Stat grid (Home) ──────────────────────────────────────── */

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 14px;
  margin-bottom: 8px;
}

.stat-card {
  background: linear-gradient(165deg, rgba(226,185,77,0.06) 0%, var(--surface) 40%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 22px;
  position: relative;
  overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.stat-card:hover {
  border-color: var(--border-strong);
  box-shadow: 0 0 32px var(--gold-glow);
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--gold-dim) 20%,
              var(--gold-bright) 50%, var(--gold-dim) 80%, transparent 100%);
}

.stat-card::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 80px; height: 80px;
  background: radial-gradient(circle at top right, var(--gold-glow) 0%, transparent 70%);
  pointer-events: none;
}

.stat-card__label {
  display: block;
  font-size: 0.68rem;
  color: var(--gold-dim);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
}

.stat-card__value {
  display: block;
  font-family: var(--font-serif);
  font-size: 1.85rem;
  font-weight: 500;
  color: var(--gold-bright);
  margin-top: 8px;
  letter-spacing: -0.02em;
  text-shadow: 0 0 40px var(--gold-glow);
}

.stat-card__hint {
  display: block;
  font-size: 0.74rem;
  margin-top: 6px;
  color: var(--text-muted);
}

/* ── Buttons ───────────────────────────────────────────────── */

.ecc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 11px;
  border: none;
  font-family: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: all 0.18s ease;
  background: linear-gradient(145deg, var(--gold-soft) 0%, var(--gold) 50%, var(--gold-dim) 100%);
  color: #000;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.12) inset,
    0 0 28px var(--gold-glow-strong),
    0 4px 12px rgba(0,0,0,0.35);
}

.ecc-btn:hover:not(:disabled) {
  background: linear-gradient(145deg, #f8e5a8 0%, var(--gold-bright) 50%, var(--gold) 100%);
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.2) inset,
    0 0 40px var(--gold-glow-max),
    0 4px 16px rgba(0,0,0,0.4);
  transform: translateY(-1px);
}

.ecc-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
}

.ecc-btn--inline { padding: 9px 16px; font-size: 0.82rem; }

.ecc-btn--ghost {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
  box-shadow: none;
}

.ecc-btn--ghost:hover:not(:disabled) {
  background: var(--gold-glow);
  color: var(--gold-bright);
  border-color: var(--border-strong);
  box-shadow: 0 0 16px var(--gold-glow);
  transform: translateY(-1px);
}

.ecc-btn--danger {
  background: transparent;
  color: var(--danger);
  border: 1px solid rgba(224,112,112,0.35);
  box-shadow: none;
}

.ecc-btn--danger:hover:not(:disabled) {
  background: rgba(224,112,112,0.1);
  border-color: rgba(224,112,112,0.6);
  box-shadow: 0 0 16px rgba(224,112,112,0.2);
  transform: translateY(-1px);
}

.ecc-btn__label { line-height: 1; }

.ecc-spinner {
  display: none;
  width: 14px; height: 14px;
  border-radius: 50%;
  border: 2px solid rgba(0,0,0,0.25);
  border-top-color: #000;
  animation: eccSpin 0.8s linear infinite;
}

.ecc-spinner--on { display: inline-block; }

/* ── Links ─────────────────────────────────────────────────── */

.ecc-link {
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  color: var(--gold-dim);
  cursor: pointer;
  transition: color 0.15s;
}

.ecc-link--strong { color: var(--gold-bright); font-weight: 600; }

.ecc-link:hover { color: var(--gold-bright); }

/* ── Alerts ────────────────────────────────────────────────── */

.ecc-alert {
  display: block;
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  line-height: 1.45;
  margin-bottom: 16px;
  border: 1px solid;
}

.ecc-alert--error {
  color: var(--danger);
  background: rgba(224,112,112,0.08);
  border-color: rgba(224,112,112,0.3);
}

.ecc-alert--success {
  color: var(--success);
  background: rgba(107,203,138,0.08);
  border-color: rgba(107,203,138,0.3);
}

/* ── Form fields ───────────────────────────────────────────── */

.ecc-field {
  position: relative;
  margin-bottom: 16px;
}

.ecc-field input,
.ecc-field select,
.ecc-field textarea {
  width: 100%;
  padding: 12px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;
  color: var(--text);
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 450;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
}

.ecc-field input::placeholder,
.ecc-field textarea::placeholder {
  color: transparent;
}

.ecc-field select {
  appearance: none;
  -webkit-appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--gold-dim) 50%),
    linear-gradient(135deg, var(--gold-dim) 50%, transparent 50%);
  background-position:
    calc(100% - 18px) 50%, calc(100% - 13px) 50%;
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
  padding-right: 36px;
  cursor: pointer;
}

.ecc-field select option {
  background: #111;
  color: var(--text);
}

.ecc-field input:focus,
.ecc-field select:focus,
.ecc-field textarea:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px var(--gold-glow), 0 0 20px var(--gold-glow);
}

.ecc-field label,
.ecc-field__label {
  display: block;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--gold-dim);
  margin-bottom: 6px;
}

/* Floating-label style used by the existing markup: label after input */
.ecc-field > input + label,
.ecc-field > textarea + label {
  position: absolute;
  top: -9px; left: 12px;
  background: var(--bg);
  padding: 0 6px;
  margin: 0;
  font-size: 0.66rem;
  letter-spacing: 0.08em;
  pointer-events: none;
}

.ecc-field__message {
  font-size: 0.74rem;
  color: var(--danger);
  margin-top: 6px;
}

.ecc-field--error input,
.ecc-field--error select,
.ecc-field--error textarea {
  border-color: rgba(224,112,112,0.55);
  box-shadow: 0 0 0 3px rgba(224,112,112,0.12);
}

.ecc-field--notes textarea {
  min-height: 96px;
  resize: vertical;
  font-family: inherit;
  line-height: 1.5;
}

.ecc-field--tags .tag-input-row {
  display: flex;
  gap: 8px;
}

.ecc-field--tags .tag-input-row input { flex: 1; }

.tag-add-btn {
  padding: 0 16px;
  border-radius: 11px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--gold-bright);
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}

.tag-add-btn:hover {
  background: var(--gold-glow);
  border-color: var(--border-strong);
}

.tag-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(226,185,77,0.08);
  border: 1px solid var(--border);
  color: var(--gold-bright);
  font-size: 0.74rem;
  font-weight: 600;
}

.tag-chip__remove {
  background: none;
  border: none;
  color: var(--gold-dim);
  cursor: pointer;
  padding: 0;
  font-size: 0.9rem;
  line-height: 1;
}

.tag-chip__remove:hover { color: var(--danger); }

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 9px;
  border-radius: 6px;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  background: rgba(226,185,77,0.06);
  border: 1px solid var(--border);
  color: var(--gold-bright);
}

.ecc-row { margin: 8px 0 16px; }

.ecc-checkbox {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--text-muted);
  cursor: pointer;
}

.ecc-checkbox input {
  width: auto;
  margin: 0;
  accent-color: var(--gold);
}

.ecc-field__toggle {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  padding: 4px;
  display: inline-flex;
}

.ecc-field__toggle:hover { color: var(--gold-bright); }

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 16px;
  margin-bottom: 8px;
}

/* ── Page toolbar ──────────────────────────────────────────── */

.page-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.page-toolbar__search {
  flex: 1;
  min-width: 240px;
  position: relative;
  display: flex;
  align-items: center;
}

.page-toolbar__search svg {
  position: absolute;
  left: 12px;
  color: var(--gold-dim);
  pointer-events: none;
}

.page-toolbar__search input {
  width: 100%;
  padding: 10px 14px 10px 36px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;
  color: var(--text);
  font-size: 0.87rem;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.page-toolbar__search input::placeholder { color: var(--text-dim); }

.page-toolbar__search input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px var(--gold-glow), 0 0 20px var(--gold-glow);
}

.page-toolbar__spinner {
  position: absolute;
  right: 12px;
  width: 14px; height: 14px;
  border-radius: 50%;
  border: 2px solid var(--border);
  border-top-color: var(--gold-bright);
  animation: eccSpin 0.8s linear infinite;
}

.page-toolbar__summary {
  margin-top: 14px;
  font-size: 0.78rem;
  color: var(--text-dim);
  text-align: center;
}

/* ── Badges ────────────────────────────────────────────────── */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border: 1px solid transparent;
  background: var(--surface-3);
  color: var(--text-muted);
}

.badge::before {
  content: '';
  width: 5px; height: 5px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 6px currentColor;
}

.badge--lead          { background: rgba(126,184,212,0.12); color: var(--info);    border-color: rgba(126,184,212,0.22); }
.badge--qualified     { background: var(--gold-glow);       color: var(--gold);    border-color: var(--border); }
.badge--proposal      { background: var(--gold-glow-strong);color: var(--gold-bright); border-color: var(--border-strong); }
.badge--negotiation   { background: rgba(226,185,77,0.14);  color: var(--gold-soft); border-color: var(--border); }
.badge--customer      { background: rgba(107,203,138,0.12); color: var(--success); border-color: rgba(107,203,138,0.28); }
.badge--won           { background: rgba(107,203,138,0.18); color: var(--success); border-color: rgba(107,203,138,0.4); }
.badge--lost          { background: rgba(224,112,112,0.12); color: var(--danger);  border-color: rgba(224,112,112,0.28); }
.badge--info          { background: rgba(126,184,212,0.12); color: var(--info);    border-color: rgba(126,184,212,0.28); }
.badge--success       { background: rgba(107,203,138,0.12); color: var(--success); border-color: rgba(107,203,138,0.28); }
.badge--muted         { background: var(--surface-3);       color: var(--text-muted); border-color: var(--border-soft); }

/* ── Table ─────────────────────────────────────────────────── */

.table-wrap {
  background: linear-gradient(165deg, rgba(226,185,77,0.03) 0%, var(--surface) 35%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 0 40px rgba(0,0,0,0.35), inset 0 1px 0 var(--border-soft);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table thead th {
  text-align: left;
  padding: 14px 20px;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold-dim);
  background: rgba(226,185,77,0.05);
  border-bottom: 1px solid var(--border);
}

.data-table tbody td {
  padding: 14px 20px;
  border-bottom: 1px solid var(--border-soft);
  font-size: 0.88rem;
  color: var(--text);
  vertical-align: middle;
}

.data-table tbody tr {
  transition: background 0.15s;
}

.contact-row { cursor: pointer; }

.contact-row:hover td {
  background: rgba(226,185,77,0.05);
}

.contact-name-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.contact-avatar {
  width: 34px; height: 34px;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--gold-soft), var(--gold-dim));
  color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.74rem;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 0 12px var(--gold-glow);
}

.contact-name-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.contact-name {
  font-weight: 600;
  color: var(--text);
  font-size: 0.92rem;
}

.contact-email {
  font-size: 0.76rem;
  color: var(--text-dim);
}

.contact-date { color: var(--text-muted); font-size: 0.84rem; }

.contact-actions-cell,
.cell-actions {
  text-align: right;
  white-space: nowrap;
}

.row-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px; height: 30px;
  border-radius: 8px;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  cursor: pointer;
  margin-left: 4px;
  transition: all 0.15s;
}

.row-action:hover {
  color: var(--gold-bright);
  background: var(--gold-glow);
  border-color: var(--border);
}

.row-action--danger:hover {
  color: var(--danger);
  background: rgba(224,112,112,0.1);
  border-color: rgba(224,112,112,0.4);
}

.row-action--tiny { width: 24px; height: 24px; }

.row-action-group { display: flex; gap: 4px; }

.cell-primary {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cell-primary strong { color: var(--text); font-weight: 600; }

.cell-secondary {
  font-size: 0.76rem;
  color: var(--text-dim);
}

/* ── Skeleton ──────────────────────────────────────────────── */

.skeleton-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-soft);
}

.skeleton-row:last-child { border-bottom: none; }

.skeleton-avatar {
  width: 34px; height: 34px;
  border-radius: 50%;
  background: linear-gradient(90deg, var(--surface-2) 25%, var(--surface-3) 50%, var(--surface-2) 75%);
  background-size: 200% 100%;
  animation: eccShimmer 1.5s linear infinite;
  flex-shrink: 0;
}

.skeleton-line {
  height: 10px;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--surface-2) 25%, var(--surface-3) 50%, var(--surface-2) 75%);
  background-size: 200% 100%;
  animation: eccShimmer 1.5s linear infinite;
}

.skeleton-line--short  { width: 80px; }
.skeleton-line--medium { width: 180px; }
.skeleton-line--long   { width: 320px; max-width: 100%; }

@keyframes eccShimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}

/* ── Empty state ───────────────────────────────────────────── */

.empty-state {
  padding: 60px 24px;
  text-align: center;
  border: 1px dashed var(--border);
  border-radius: var(--radius);
  background: rgba(226,185,77,0.02);
}

.empty-state__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px; height: 52px;
  border-radius: 14px;
  background: var(--gold-glow);
  border: 1px solid var(--border);
  color: var(--gold-bright);
  margin-bottom: 18px;
  box-shadow: 0 0 24px var(--gold-glow);
}

.empty-state__title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 500;
  color: var(--gold-bright);
  margin-bottom: 8px;
}

.empty-state__desc {
  color: var(--text-muted);
  font-size: 0.88rem;
  max-width: 380px;
  margin: 0 auto 20px;
  line-height: 1.55;
}

.empty-state__action { margin-top: 16px; }

/* ── Pagination ────────────────────────────────────────────── */

.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20px;
  padding: 0 4px;
}

.pagination__info {
  font-size: 0.8rem;
  color: var(--text-dim);
}

.pagination__btns {
  display: flex;
  gap: 8px;
}

/* ── Detail pages ──────────────────────────────────────────── */

.detail { position: relative; }

.detail__back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 0.85rem;
  cursor: pointer;
  padding: 6px 0;
  margin-bottom: 20px;
  transition: color 0.15s;
}

.detail__back:hover { color: var(--gold-bright); }

.detail-hero {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 24px;
  align-items: center;
  padding: 28px;
  background: linear-gradient(165deg, rgba(226,185,77,0.06) 0%, var(--surface) 40%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  position: relative;
  overflow: hidden;
  margin-bottom: 24px;
}

.detail-hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--gold-dim) 20%,
              var(--gold-bright) 50%, var(--gold-dim) 80%, transparent 100%);
}

.detail-hero__avatar {
  width: 76px; height: 76px;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--gold-soft), var(--gold-dim));
  color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  box-shadow: 0 0 0 4px rgba(0,0,0,0.4), 0 0 28px var(--gold-glow);
  flex-shrink: 0;
}

.detail-hero__avatar--deal {
  background: linear-gradient(145deg, var(--surface-3), var(--surface-2));
  color: var(--gold-bright);
  font-size: 1rem;
  border: 1px solid var(--gold);
  box-shadow: 0 0 0 4px rgba(0,0,0,0.4), 0 0 28px var(--gold-glow-strong);
}

.detail-hero__body { min-width: 0; }

.detail-hero__title-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.detail-hero__name {
  font-family: var(--font-serif);
  font-size: 1.55rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.025em;
  line-height: 1.2;
  text-shadow: 0 0 30px var(--gold-glow);
}

.detail-hero__role {
  font-size: 0.92rem;
  color: var(--text-muted);
  margin-top: 6px;
}

.detail-hero__contact {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}

.detail-hero__chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 11px;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: rgba(226,185,77,0.05);
  color: var(--text-muted);
  font-size: 0.78rem;
  text-decoration: none;
  transition: all 0.15s;
}

.detail-hero__chip:hover {
  color: var(--gold-bright);
  border-color: var(--border-strong);
  background: var(--gold-glow);
}

.detail-hero__actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.detail-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
  margin-bottom: 24px;
}

.detail-stat {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 16px 18px;
  position: relative;
  overflow: hidden;
}

.detail-stat::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: linear-gradient(180deg, var(--gold-bright), var(--gold-dim));
  opacity: 0.6;
}

.detail-stat__label {
  display: block;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-dim);
}

.detail-stat__value {
  display: block;
  font-family: var(--font-serif);
  font-size: 1.28rem;
  font-weight: 500;
  color: var(--gold-bright);
  margin-top: 6px;
  letter-spacing: -0.02em;
}

.detail-stat__hint {
  display: block;
  font-size: 0.7rem;
  color: var(--text-dim);
  margin-top: 4px;
}

.detail__grid {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 22px;
  align-items: start;
}

.detail__sidebar {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.detail__main {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

/* ── Detail cards ──────────────────────────────────────────── */

.detail-card {
  background: linear-gradient(165deg, rgba(226,185,77,0.04) 0%, var(--surface) 40%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  position: relative;
}

.detail-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.5;
}

.detail-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-soft);
  background: linear-gradient(180deg, rgba(226,185,77,0.05) 0%, transparent 100%);
}

.detail-card__title {
  font-family: var(--font-serif);
  font-size: 0.98rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.01em;
}

.detail-card__action {
  background: none;
  border: none;
  color: var(--gold-bright);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
  transition: all 0.15s;
}

.detail-card__action:hover:not(:disabled) {
  background: var(--gold-glow);
  color: var(--gold-soft);
}

.detail-card__action:disabled {
  color: var(--text-dim);
  cursor: not-allowed;
}

.detail-card > :not(.detail-card__header) {
  padding: 18px 20px;
}

/* Info list */

.info-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.info-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.info-row__icon {
  flex-shrink: 0;
  width: 30px; height: 30px;
  border-radius: 9px;
  background: rgba(226,185,77,0.06);
  border: 1px solid var(--border-soft);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--gold-dim);
  margin-top: 2px;
}

.info-row__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.info-row__label {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-dim);
}

.info-row__value {
  font-size: 0.88rem;
  color: var(--text);
  font-weight: 500;
  word-break: break-word;
}

.detail-notes {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.6;
  white-space: pre-wrap;
}

.detail-muted {
  font-size: 0.84rem;
  color: var(--text-dim);
  font-style: italic;
}

.detail-empty {
  text-align: center;
  padding: 30px 20px;
}

.detail-empty__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px; height: 46px;
  border-radius: 12px;
  background: var(--gold-glow);
  border: 1px solid var(--border);
  color: var(--gold-bright);
  margin-bottom: 14px;
}

.detail-empty__title {
  font-family: var(--font-serif);
  font-size: 0.98rem;
  color: var(--gold-bright);
  margin-bottom: 6px;
}

.detail-empty__desc {
  font-size: 0.82rem;
  color: var(--text-muted);
  max-width: 320px;
  margin: 0 auto;
  line-height: 1.5;
}

/* ── Activity / deal / task rows in detail cards ───────────── */

.activity-list { display: flex; flex-direction: column; }

.activity-loading {
  padding: 24px 0;
  text-align: center;
  font-size: 0.82rem;
  color: var(--text-dim);
}

.activity-item {
  display: flex;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border-soft);
}

.activity-item:last-child { border-bottom: none; }

.activity-item__marker {
  flex-shrink: 0;
  width: 8px; height: 8px;
  border-radius: 50%;
  margin-top: 7px;
  background: var(--gold);
  box-shadow: 0 0 10px var(--gold-glow-strong);
}

.activity-item__marker--email   { background: var(--info);    box-shadow: 0 0 10px rgba(126,184,212,0.5); }
.activity-item__marker--call    { background: var(--success); box-shadow: 0 0 10px rgba(107,203,138,0.5); }
.activity-item__marker--meeting { background: var(--gold-bright); box-shadow: 0 0 10px var(--gold-glow-max); }
.activity-item__marker--note    { background: var(--gold-dim); }
.activity-item__marker--task    { background: var(--danger);  box-shadow: 0 0 10px rgba(224,112,112,0.5); }

.activity-item__body { flex: 1; min-width: 0; }

.activity-item__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  font-size: 0.72rem;
  color: var(--text-dim);
  margin-bottom: 5px;
}

.activity-item__kind {
  color: var(--gold-dim);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.62rem;
}

.activity-item__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.activity-item__title {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text);
  font-family: var(--font-sans);
  letter-spacing: 0;
}

.activity-item__text {
  margin-top: 6px;
  font-size: 0.83rem;
  color: var(--text-muted);
  line-height: 1.5;
}

/* ── Modal ─────────────────────────────────────────────────── */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 60px 20px;
  overflow-y: auto;
  animation: eccFadeIn 0.15s ease-out;
}

@keyframes eccFadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal {
  width: 100%;
  max-width: 620px;
  background: linear-gradient(165deg, rgba(226,185,77,0.04) 0%, var(--surface) 30%);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  box-shadow:
    0 40px 100px rgba(0,0,0,0.7),
    0 0 80px var(--gold-glow),
    inset 0 1px 0 var(--border-soft);
  animation: eccModalIn 0.2s ease-out;
  position: relative;
  overflow: hidden;
}

.modal::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--gold-dim) 20%,
              var(--gold-bright) 50%, var(--gold-dim) 80%, transparent 100%);
}

@keyframes eccModalIn {
  from { opacity: 0; transform: translateY(12px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.modal--wide   { max-width: 780px; }
.modal--narrow { max-width: 440px; }

.modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid var(--border-soft);
  background: linear-gradient(180deg, rgba(226,185,77,0.06) 0%, transparent 100%);
}

.modal__title {
  font-family: var(--font-serif);
  font-size: 1.14rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.015em;
}

.modal__close {
  width: 32px; height: 32px;
  border-radius: 9px;
  background: transparent;
  border: 1px solid var(--border-soft);
  color: var(--text-muted);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  transition: all 0.15s;
}

.modal__close:hover {
  color: var(--gold-bright);
  border-color: var(--border-strong);
  background: var(--gold-glow);
}

.modal > form,
.modal > .modal__confirm,
.modal > p {
  padding: 22px 24px;
}

.modal__actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 18px;
  margin-top: 10px;
  border-top: 1px solid var(--border-soft);
}

.modal__confirm { padding: 22px 24px; }

.modal__confirm-text {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.55;
  margin-bottom: 18px;
}

.modal__confirm-text strong {
  color: var(--gold-bright);
  font-weight: 600;
}

/* ── Stage pills ───────────────────────────────────────────── */

.stage-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
}

.stage-pills--detail { margin-top: 6px; }

.stage-pill {
  padding: 6px 12px;
  border-radius: 20px;
  border: 1px solid var(--border-soft);
  background: transparent;
  color: var(--text-muted);
  font-size: 0.76rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
  letter-spacing: 0.01em;
}

.stage-pill:hover:not(:disabled) {
  color: var(--gold-bright);
  border-color: var(--border);
  background: var(--gold-glow);
}

.stage-pill--active {
  background: linear-gradient(145deg, var(--gold-soft), var(--gold));
  color: #000;
  border-color: var(--gold-bright);
  box-shadow: 0 0 16px var(--gold-glow-strong);
}

.stage-pill--active:hover {
  background: linear-gradient(145deg, #f8e5a8, var(--gold-bright));
  color: #000;
}

.stage-pill:disabled { opacity: 0.4; cursor: not-allowed; }

/* ── Deals board ───────────────────────────────────────────── */

.deals-summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 12px;
  margin-bottom: 22px;
}

.deals-summary__kpi {
  background: linear-gradient(165deg, rgba(226,185,77,0.05) 0%, var(--surface) 40%);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 18px;
  position: relative;
  overflow: hidden;
}

.deals-summary__kpi::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold-dim), transparent);
  opacity: 0.7;
}

.deals-summary__kpi--won::before   { background: linear-gradient(90deg, transparent, var(--success), transparent); }
.deals-summary__kpi--weighted::before { background: linear-gradient(90deg, transparent, var(--gold-bright), transparent); }

.deals-summary__label {
  display: block;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-dim);
}

.deals-summary__value {
  display: block;
  font-family: var(--font-serif);
  font-size: 1.45rem;
  font-weight: 500;
  color: var(--gold-bright);
  margin-top: 6px;
  letter-spacing: -0.02em;
}

.deals-summary__hint {
  font-size: 0.72rem;
  color: var(--text-dim);
  margin-top: 4px;
}

.deals-summary--loading { opacity: 0.7; }

.deals-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  padding: 14px 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.deals-filters__group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.deals-filters__label {
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-dim);
}

.deals-filters__group select,
.deals-filters__group input {
  padding: 7px 11px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  font-size: 0.82rem;
  outline: none;
}

.deals-filters__group select:focus,
.deals-filters__group input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 2px var(--gold-glow);
}

.deals-filters__count {
  margin-left: auto;
  font-size: 0.78rem;
  color: var(--text-dim);
}

.deals-filters__clear {
  background: none;
  border: none;
  color: var(--gold-bright);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
}

.deals-filters__clear:hover { background: var(--gold-glow); }

.deals-bulk-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  margin-bottom: 16px;
  background: linear-gradient(135deg, var(--gold-glow-strong) 0%, rgba(226,185,77,0.06) 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: 0 0 24px var(--gold-glow);
}

.deals-bulk-bar__count {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--gold-bright);
}

.deals-bulk-bar__spacer { flex: 1; }

.deals-bulk-bar__actions { display: flex; gap: 8px; }

.deals-bulk-bar__btn {
  padding: 6px 12px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: rgba(0,0,0,0.3);
  color: var(--gold-bright);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}

.deals-bulk-bar__btn:hover {
  background: var(--gold-glow);
  border-color: var(--border-strong);
}

.deals-bulk-bar__btn--danger {
  color: var(--danger);
  border-color: rgba(224,112,112,0.35);
}

.deals-bulk-bar__btn--danger:hover {
  background: rgba(224,112,112,0.12);
  border-color: rgba(224,112,112,0.6);
}

.deals-bulk-bar__close {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 1.3rem;
  line-height: 1;
  cursor: pointer;
  padding: 0 6px;
}

.deals-bulk-bar__close:hover { color: var(--gold-bright); }

/* Pipeline board */

.pipeline-board {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 280px;
  gap: 16px;
  overflow-x: auto;
  padding-bottom: 12px;
}

.pipeline-col {
  background: linear-gradient(180deg, rgba(226,185,77,0.03) 0%, var(--surface) 20%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  min-height: 260px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.pipeline-col--lead::before,
.pipeline-col--qualified::before,
.pipeline-col--proposal::before,
.pipeline-col--negotiation::before,
.pipeline-col--won::before,
.pipeline-col--lost::before {
  content: '';
  display: block;
  height: 2px;
  border-radius: 2px;
  margin: -14px -12px 12px;
  background: var(--gold-dim);
}

.pipeline-col--lead::before        { background: linear-gradient(90deg, var(--info), transparent); }
.pipeline-col--qualified::before   { background: linear-gradient(90deg, var(--gold-dim), transparent); }
.pipeline-col--proposal::before    { background: linear-gradient(90deg, var(--gold), transparent); }
.pipeline-col--negotiation::before { background: linear-gradient(90deg, var(--gold-bright), transparent); }
.pipeline-col--won::before         { background: linear-gradient(90deg, var(--success), transparent); }
.pipeline-col--lost::before        { background: linear-gradient(90deg, var(--danger), transparent); }

.pipeline-col--drop-target {
  border-color: var(--gold-bright);
  box-shadow: 0 0 0 1px var(--gold-bright), 0 0 30px var(--gold-glow-strong);
}

.pipeline-col__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.pipeline-col__title-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pipeline-col__dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 8px var(--gold-glow-strong);
}

.pipeline-col__title {
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--gold-bright);
  letter-spacing: 0.01em;
}

.pipeline-col__count {
  font-size: 0.68rem;
  color: var(--text-dim);
  padding: 1px 7px;
  background: var(--surface-3);
  border-radius: 20px;
}

.pipeline-col__add {
  width: 24px; height: 24px;
  border-radius: 7px;
  background: transparent;
  border: 1px solid var(--border-soft);
  color: var(--text-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s;
}

.pipeline-col__add:hover {
  color: var(--gold-bright);
  background: var(--gold-glow);
  border-color: var(--border);
}

.pipeline-col__totals {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
}

.pipeline-col__total {
  font-family: var(--font-serif);
  font-size: 1.08rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.02em;
}

.pipeline-col__total--muted { color: var(--text-dim); font-size: 0.9rem; }

.pipeline-col__weighted {
  font-size: 0.68rem;
  color: var(--text-dim);
}

.pipeline-col__weighted strong {
  color: var(--gold-dim);
  font-weight: 600;
}

.pipeline-col__bar {
  height: 3px;
  background: var(--surface-3);
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 12px;
}

.pipeline-col__bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold-dim), var(--gold-bright));
  box-shadow: 0 0 8px var(--gold-glow);
  border-radius: 2px;
  transition: width 0.3s ease;
}

.pipeline-col__empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 24px 8px;
  color: var(--text-dim);
  font-size: 0.76rem;
  border: 1px dashed var(--border-soft);
  border-radius: var(--radius-sm);
}

.pipeline-col__empty-icon {
  color: var(--gold-dim);
  opacity: 0.5;
}

.pipeline-col__cards {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

/* Deal cards */

.deal-card {
  background: linear-gradient(165deg, rgba(226,185,77,0.04) 0%, var(--surface-2) 40%);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  cursor: pointer;
  transition: all 0.18s ease;
  position: relative;
  outline: none;
}

.deal-card:hover {
  border-color: var(--border-strong);
  box-shadow: 0 0 24px var(--gold-glow), 0 4px 12px rgba(0,0,0,0.3);
  transform: translateY(-1px);
}

.deal-card--selectable { padding-left: 32px; }

.deal-card--dragging { opacity: 0.5; }

.deal-card--moving { opacity: 0.7; }

.deal-card--selected {
  border-color: var(--gold);
  background: linear-gradient(135deg, var(--gold-glow-strong) 0%, rgba(226,185,77,0.04) 100%);
  box-shadow: 0 0 0 1px var(--gold), 0 0 24px var(--gold-glow);
}

.deal-card__checkbox {
  position: absolute;
  left: 10px;
  top: 14px;
  width: 16px; height: 16px;
  border-radius: 4px;
  border: 1.5px solid var(--border-strong);
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #000;
  font-size: 0.7rem;
  line-height: 1;
  padding: 0;
  transition: all 0.15s;
}

.deal-card__checkbox:hover {
  border-color: var(--gold-bright);
  background: var(--gold-glow);
}

.deal-card__checkbox--checked {
  background: linear-gradient(145deg, var(--gold-soft), var(--gold));
  border-color: var(--gold-bright);
  box-shadow: 0 0 10px var(--gold-glow-strong);
}

.deal-card__menu {
  position: absolute;
  top: 8px; right: 8px;
  display: flex;
  gap: 2px;
  opacity: 0;
  transition: opacity 0.15s;
}

.deal-card:hover .deal-card__menu { opacity: 1; }

.deal-card__value {
  margin-bottom: 6px;
}

.deal-card__value-amount {
  font-family: var(--font-serif);
  font-size: 1.02rem;
  font-weight: 500;
  color: var(--gold-bright);
  letter-spacing: -0.015em;
}

.deal-card__value-amount--zero {
  color: var(--text-dim);
  font-size: 0.82rem;
  font-family: var(--font-sans);
}

.deal-card__title {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
  margin-bottom: 8px;
}

.deal-card__contact {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 4px 0;
  font-size: 0.76rem;
  color: var(--text-muted);
}

.deal-card__contact--link {
  cursor: pointer;
  border-radius: 6px;
  padding: 4px 6px;
  margin: -4px -6px;
  transition: background 0.15s;
}

.deal-card__contact--link:hover {
  background: var(--gold-glow);
  color: var(--gold-bright);
}

.deal-card__contact-avatar {
  width: 20px; height: 20px;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--gold-soft), var(--gold-dim));
  color: #000;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.6rem;
  font-weight: 700;
}

.deal-card__contact-name { font-weight: 500; }

.deal-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border-soft);
}

.deal-card__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  font-size: 0.68rem;
  color: var(--text-dim);
}

.deal-card__meta-item {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.deal-card__meta-icon { color: var(--gold-dim); display: inline-flex; }

.deal-card__meta-sep { color: var(--text-dim); }

.deal-card__age {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--surface-3);
  font-weight: 600;
  letter-spacing: 0.03em;
}

.deal-card__age--stale { background: rgba(226,185,77,0.12); color: var(--gold-bright); }
.deal-card__age--critical { background: rgba(224,112,112,0.12); color: var(--danger); }

.deal-card__stale-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 6px currentColor;
}

.deal-card__move { display: flex; gap: 4px; }

.deal-move-btn {
  width: 22px; height: 22px;
  border-radius: 6px;
  background: transparent;
  border: 1px solid var(--border-soft);
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.15s;
}

.deal-move-btn:hover:not(:disabled) {
  color: var(--gold-bright);
  background: var(--gold-glow);
  border-color: var(--border-strong);
}

.deal-move-btn:disabled { opacity: 0.3; cursor: not-allowed; }

/* ── Settings ──────────────────────────────────────────────── */

.settings__header { margin-bottom: 28px; }

.settings__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  align-items: start;
}

.settings-form { display: flex; flex-direction: column; }

.settings-actions {
  margin-top: 16px;
  display: flex;
  justify-content: flex-end;
}

.settings-status {
  margin-top: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  border: 1px solid;
}

.settings-status--ok {
  color: var(--success);
  background: rgba(107,203,138,0.08);
  border-color: rgba(107,203,138,0.28);
}

.settings-status--error {
  color: var(--danger);
  background: rgba(224,112,112,0.08);
  border-color: rgba(224,112,112,0.28);
}

.settings-session {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.settings-session__title {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4px;
  font-family: var(--font-sans);
  letter-spacing: 0;
}

.settings-session__desc {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.5;
  max-width: 320px;
}

/* ── Toast ─────────────────────────────────────────────────── */

.toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 900;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px;
  background: linear-gradient(145deg, var(--gold-soft), var(--gold));
  color: #000;
  border-radius: 24px;
  font-size: 0.86rem;
  font-weight: 600;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.15) inset,
    0 0 40px var(--gold-glow-max),
    0 12px 32px rgba(0,0,0,0.5);
  animation: eccToastIn 0.25s ease-out;
}

@keyframes eccToastIn {
  from { opacity: 0; transform: translate(-50%, 12px); }
  to   { opacity: 1; transform: translate(-50%, 0); }
}

/* ── Scrollbar ─────────────────────────────────────────────── */

::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--gold-dim), var(--border-strong));
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover { background: var(--gold); }

/* ── Responsive ────────────────────────────────────────────── */

@media (max-width: 1100px) {
  .detail__grid { grid-template-columns: 1fr; }
  .settings__grid { grid-template-columns: 1fr; }
  .app-shell { grid-template-columns: 220px 1fr; }
}

@media (max-width: 900px) {
  .ecc-split { grid-template-columns: 1fr; }
  .brand-panel { display: none; }
  .app-shell { grid-template-columns: 1fr; }
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 260px;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    z-index: 200;
  }
  .sidebar.is-open { transform: translateX(0); }
  .topbar { padding: 0 20px; }
  .content { padding: 20px; }
  .form-grid { grid-template-columns: 1fr; }
  .detail-hero { grid-template-columns: 1fr; text-align: left; }
  .detail-hero__avatar { width: 60px; height: 60px; font-size: 1.15rem; }
  .detail-hero__actions { justify-content: flex-start; }
  .motif-orb { display: none; }
  .pipeline-board { grid-auto-columns: 260px; }
  .data-table { font-size: 0.82rem; }
  .data-table thead th,
  .data-table tbody td { padding: 12px 14px; }
}