/* ============================================================
   ECC-CRM — Design System
   ============================================================ */

:root {
  --ecc-bg: #070a12;
  --ecc-surface-1: #0c111d;
  --ecc-surface-2: #131a2a;
  --ecc-surface-3: #1a2338;

  --ecc-border-subtle: #1a2338;
  --ecc-border: #232d44;
  --ecc-border-strong: #31405e;

  --ecc-text: #f0f3fa;
  --ecc-text-muted: #8b95b0;
  --ecc-text-subtle: #5c6784;

  --ecc-primary: #6366f1;
  --ecc-primary-hover: #7c7ff5;
  --ecc-primary-soft: rgba(99, 102, 241, 0.12);
  --ecc-accent: #06b6d4;
  --ecc-accent-soft: rgba(6, 182, 212, 0.12);

  --ecc-success: #10b981;
  --ecc-success-soft: rgba(16, 185, 129, 0.12);
  --ecc-warning: #f59e0b;
  --ecc-warning-soft: rgba(245, 158, 11, 0.12);
  --ecc-error: #f43f5e;
  --ecc-error-soft: rgba(244, 63, 94, 0.12);

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;

  --radius-sm: 6px;
  --radius: 10px;
  --radius-lg: 14px;
  --radius-full: 999px;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.5);
  --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.6);

  --t-fast: 0.12s cubic-bezier(0.4, 0, 0.2, 1);
  --t: 0.2s cubic-bezier(0.4, 0, 0.2, 1);

  --fs-caption: 11px;
  --fs-small: 12px;
  --fs-body: 13.5px;
  --fs-body-lg: 15px;
  --fs-h4: 16px;
  --fs-h3: 18px;
  --fs-h2: 22px;
  --fs-h1: 28px;
  --fs-display: 40px;
}

* {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
  margin: 0;
}

body {
  font-family: "Inter", system-ui, -apple-system, sans-serif;
  background: var(--ecc-bg);
  color: var(--ecc-text);
  font-size: var(--fs-body);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
a:focus-visible {
  outline: 2px solid var(--ecc-primary);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.ecc-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============================================================
   LOGIN
   ============================================================ */

.ecc-split {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
}

@media (max-width: 900px) {
  .ecc-split {
    grid-template-columns: 1fr;
  }
  .brand-panel {
    display: none;
  }
}

.brand-panel {
  position: relative;
  background:
    radial-gradient(ellipse 80% 60% at 20% 0%, rgba(99, 102, 241, 0.15), transparent 70%),
    radial-gradient(ellipse 60% 80% at 80% 100%, rgba(6, 182, 212, 0.12), transparent 70%),
    linear-gradient(160deg, #0a0f1e 0%, #070a12 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-10);
}

.brand-panel__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  pointer-events: none;
}

.brand-panel__glow--1 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.5) 0%, transparent 70%);
  top: -200px;
  left: -200px;
}

.brand-panel__glow--2 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.4) 0%, transparent 70%);
  bottom: -150px;
  right: -150px;
}

.brand-panel__inner {
  position: relative;
  z-index: 1;
  max-width: 460px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-10);
}

.brand-panel__header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.brand-panel__wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.brand-panel__name {
  font-weight: 700;
  font-size: 17px;
  letter-spacing: 0.4px;
}

.brand-panel__product {
  font-size: 10px;
  color: var(--ecc-text-muted);
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 600;
}

.brand-panel__hero {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.brand-panel__headline {
  margin: 0;
  font-size: var(--fs-display);
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: -0.03em;
}

.brand-panel__headline-accent {
  background: linear-gradient(90deg, #818cf8, #22d3ee);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.brand-panel__lede {
  margin: 0;
  font-size: var(--fs-body-lg);
  line-height: 1.6;
  color: var(--ecc-text-muted);
  max-width: 420px;
}

.trust-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: var(--fs-body);
  color: var(--ecc-text-muted);
}

.trust-check {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: var(--radius-full);
  background: var(--ecc-primary-soft);
  color: #a5b4fc;
  flex-shrink: 0;
}

.brand-panel__footer {
  font-size: var(--fs-small);
  color: var(--ecc-text-subtle);
  margin-top: auto;
  padding-top: var(--space-6);
}

.auth-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-10);
  background: var(--ecc-bg);
}

.auth-panel__inner {
  width: 100%;
  max-width: 380px;
}

.auth-header {
  margin-bottom: var(--space-8);
}

.auth-title {
  margin: 0 0 var(--space-2);
  font-size: var(--fs-h2);
  font-weight: 600;
  letter-spacing: -0.02em;
}

.auth-subtitle {
  margin: 0;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body);
  line-height: 1.55;
}

.ecc-alert {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius);
  font-size: var(--fs-body);
  margin-bottom: var(--space-5);
  border: 1px solid transparent;
  line-height: 1.5;
}

.ecc-alert--error {
  background: var(--ecc-error-soft);
  border-color: rgba(244, 63, 94, 0.3);
  color: #fda4af;
}

.ecc-alert--success {
  background: var(--ecc-success-soft);
  border-color: rgba(16, 185, 129, 0.3);
  color: #6ee7b7;
}

.ecc-field {
  position: relative;
  margin-bottom: var(--space-4);
}

.ecc-field input,
.ecc-field select,
.ecc-field textarea {
  width: 100%;
  padding: 18px 14px 8px;
  background: var(--ecc-surface-1);
  color: var(--ecc-text);
  border: 1px solid var(--ecc-border);
  border-radius: var(--radius);
  font-size: var(--fs-body-lg);
  font-family: inherit;
  outline: none;
  transition: border-color var(--t-fast), box-shadow var(--t-fast), background var(--t-fast);
}

.ecc-field input:hover:not(:disabled),
.ecc-field select:hover:not(:disabled) {
  border-color: var(--ecc-border-strong);
}

.ecc-field input:focus,
.ecc-field select:focus {
  border-color: var(--ecc-primary);
  background: var(--ecc-surface-2);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.ecc-field input:disabled,
.ecc-field select:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.ecc-field label {
  position: absolute;
  left: 14px;
  top: 15px;
  padding: 0 4px;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body-lg);
  pointer-events: none;
  background: var(--ecc-bg);
  transition: all var(--t-fast);
}

.ecc-field input:focus + label,
.ecc-field input:not(:placeholder-shown) + label {
  top: -7px;
  font-size: var(--fs-caption);
  color: var(--ecc-primary);
  font-weight: 600;
  letter-spacing: 0.3px;
  background: var(--ecc-bg);
}

.ecc-field--error input,
.ecc-field--error select {
  border-color: var(--ecc-error);
}

.ecc-field--error input:focus {
  box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.15);
}

.ecc-field--error label {
  color: var(--ecc-error);
}

.ecc-field__message {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: var(--space-2) 0 0;
  color: #fda4af;
  font-size: var(--fs-small);
  line-height: 1.4;
}

.ecc-field__toggle {
  position: absolute;
  right: 12px;
  top: 15px;
  background: none;
  border: none;
  color: var(--ecc-text-muted);
  cursor: pointer;
  padding: 4px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-sm);
  transition: color var(--t-fast), background var(--t-fast);
}

.ecc-field__toggle:hover {
  color: var(--ecc-text);
  background: rgba(255, 255, 255, 0.05);
}

.ecc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--space-1) 0 var(--space-6);
  font-size: var(--fs-body);
}

.ecc-checkbox {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--ecc-text-muted);
  cursor: pointer;
  user-select: none;
  transition: color var(--t-fast);
}

.ecc-checkbox:hover {
  color: var(--ecc-text);
}

.ecc-checkbox input {
  accent-color: var(--ecc-primary);
  cursor: pointer;
  width: 15px;
  height: 15px;
}

.ecc-link {
  color: #a5b4fc;
  text-decoration: none;
  transition: color var(--t-fast);
  font-size: var(--fs-body);
  font-weight: 500;
}

.ecc-link:hover {
  color: #c7d2fe;
}

.ecc-link--strong {
  background: none;
  border: none;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
}

.ecc-btn {
  position: relative;
  width: 100%;
  padding: 13px 20px;
  border-radius: var(--radius);
  border: none;
  background: linear-gradient(135deg, var(--ecc-primary), #818cf8);
  color: #fff;
  font-weight: 600;
  font-size: var(--fs-body-lg);
  font-family: inherit;
  cursor: pointer;
  transition: transform var(--t-fast), box-shadow var(--t-fast), opacity var(--t-fast);
  letter-spacing: 0.01em;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.ecc-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.35);
}

.ecc-btn:active:not(:disabled) {
  transform: translateY(0);
}

.ecc-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ecc-btn--ghost {
  background: transparent;
  border: 1px solid var(--ecc-border-strong);
  color: var(--ecc-text);
  box-shadow: none;
}

.ecc-btn--ghost:hover:not(:disabled) {
  background: var(--ecc-surface-2);
  border-color: var(--ecc-border-strong);
  box-shadow: none;
  transform: none;
}

.ecc-btn--danger {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #fff;
}

.ecc-btn--danger:hover:not(:disabled) {
  box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35);
}

.ecc-btn--inline {
  width: auto;
  padding: 9px 16px;
  font-size: var(--fs-body);
}

.ecc-btn__label {
  display: inline-block;
}

.ecc-spinner {
  position: absolute;
  right: 16px;
  top: 50%;
  width: 15px;
  height: 15px;
  margin-top: -7.5px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  opacity: 0;
  transition: opacity var(--t-fast);
}

.ecc-spinner--on {
  opacity: 1;
  animation: ecc-spin 0.7s linear infinite;
}

@keyframes ecc-spin {
  to {
    transform: rotate(360deg);
  }
}

.auth-switch {
  margin: var(--space-6) 0 0;
  text-align: center;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body);
}

.auth-switch .ecc-link {
  margin-left: var(--space-1);
}

.auth-footer {
  margin-top: var(--space-8);
  padding-top: var(--space-5);
  border-top: 1px solid var(--ecc-border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  font-size: var(--fs-small);
  color: var(--ecc-text-subtle);
}

.auth-footer__lock {
  display: grid;
  place-items: center;
}

/* ============================================================
   APP SHELL
   ============================================================ */

.app-shell {
  display: grid;
  grid-template-columns: 232px 1fr;
  min-height: 100vh;
  background: var(--ecc-bg);
}

@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 64px 1fr;
  }
  .sidebar__wordmark,
  .nav-item__label,
  .sidebar__user-info,
  .sidebar__section-label {
    display: none;
  }
  .sidebar__signout-btn span:not(:first-child) {
    display: none;
  }
}

.sidebar {
  background: var(--ecc-surface-1);
  border-right: 1px solid var(--ecc-border-subtle);
  display: flex;
  flex-direction: column;
  padding: var(--space-5) var(--space-3);
  gap: var(--space-5);
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 0 var(--space-2) var(--space-2);
}

.sidebar__wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.sidebar__name {
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.3px;
}

.sidebar__product {
  font-size: 9px;
  color: var(--ecc-text-muted);
  letter-spacing: 1.8px;
  text-transform: uppercase;
  font-weight: 600;
}

.sidebar__section-label {
  font-size: var(--fs-caption);
  color: var(--ecc-text-subtle);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  font-weight: 600;
  padding: 0 var(--space-3) var(--space-2);
}

.sidebar__nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.sidebar__nav--bottom {
  flex: 0;
  padding-top: var(--space-3);
  border-top: 1px solid var(--ecc-border-subtle);
}

.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 9px var(--space-3);
  border-radius: var(--radius-sm);
  background: none;
  border: none;
  color: var(--ecc-text-muted);
  font-family: inherit;
  font-size: var(--fs-body);
  font-weight: 500;
  cursor: pointer;
  text-align: left;
  width: 100%;
  transition: background var(--t-fast), color var(--t-fast);
}

.nav-item::before {
  content: "";
  position: absolute;
  left: -12px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 0;
  background: var(--ecc-primary);
  border-radius: 0 2px 2px 0;
  transition: height var(--t-fast);
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.03);
  color: var(--ecc-text);
}

.nav-item--active {
  background: var(--ecc-primary-soft);
  color: var(--ecc-text);
}

.nav-item--active::before {
  height: 20px;
}

.nav-item--active .nav-item__icon {
  color: #a5b4fc;
}

.nav-item__icon {
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: currentColor;
  transition: color var(--t-fast);
}

.nav-item__label {
  flex: 1;
}

.sidebar__user {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-2) var(--space-2);
  border-top: 1px solid var(--ecc-border-subtle);
  margin-top: var(--space-3);
}

.sidebar__avatar {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #6366f1, #06b6d4);
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 12px;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
}

.sidebar__user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.sidebar__user-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ecc-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar__user-email {
  font-size: var(--fs-small);
  color: var(--ecc-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar__signout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 10px var(--space-3);
  background: none;
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-sm);
  color: var(--ecc-text-muted);
  font-family: inherit;
  font-size: var(--fs-body);
  font-weight: 500;
  cursor: pointer;
  width: 100%;
  transition: all var(--t-fast);
}

.sidebar__signout-btn:hover {
  color: #fda4af;
  background: var(--ecc-error-soft);
  border-color: rgba(244, 63, 94, 0.3);
}

.app-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-6);
  border-bottom: 1px solid var(--ecc-border-subtle);
  background: var(--ecc-surface-1);
  backdrop-filter: blur(8px);
}

.topbar__search {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex: 1;
  max-width: 440px;
  padding: 8px 12px;
  background: var(--ecc-bg);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-sm);
  color: var(--ecc-text-muted);
  transition: border-color var(--t-fast), background var(--t-fast);
}

.topbar__search:focus-within {
  border-color: var(--ecc-primary);
  background: var(--ecc-surface-1);
}

.topbar__search-input {
  background: none;
  border: none;
  outline: none;
  color: var(--ecc-text);
  font-size: var(--fs-body);
  font-family: inherit;
  flex: 1;
  min-width: 0;
}

.topbar__search-input::placeholder {
  color: var(--ecc-text-subtle);
}

.topbar__search-kbd {
  display: none;
  padding: 2px 6px;
  background: var(--ecc-surface-2);
  border: 1px solid var(--ecc-border);
  border-radius: 4px;
  font-size: 10.5px;
  font-family: ui-monospace, monospace;
  color: var(--ecc-text-muted);
  font-weight: 500;
}

@media (min-width: 720px) {
  .topbar__search-kbd {
    display: inline-block;
  }
}

.topbar__right {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.topbar__icon-btn {
  position: relative;
  background: none;
  border: none;
  color: var(--ecc-text-muted);
  cursor: pointer;
  padding: 8px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  transition: color var(--t-fast), background var(--t-fast);
}

.topbar__icon-btn:hover {
  color: var(--ecc-text);
  background: rgba(255, 255, 255, 0.05);
}

.topbar__icon-btn--notify::after {
  content: "";
  position: absolute;
  top: 6px;
  right: 6px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ecc-error);
  border: 2px solid var(--ecc-surface-1);
}

.topbar__avatar {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #6366f1, #06b6d4);
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 12px;
  color: #fff;
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
  cursor: pointer;
  transition: transform var(--t-fast);
}

.topbar__avatar:hover {
  transform: scale(1.05);
}

.content {
  padding: var(--space-8);
  flex: 1;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
}

.content__header {
  margin-bottom: var(--space-6);
}

.content__title {
  margin: 0;
  font-size: var(--fs-h2);
  font-weight: 600;
  letter-spacing: -0.02em;
}

.content__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.content__heading {
  margin: 0 0 var(--space-2);
  font-size: var(--fs-h1);
  font-weight: 600;
  letter-spacing: -0.025em;
}

.content__lede {
  margin: 0;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body-lg);
  line-height: 1.6;
}

.content__section {
  margin-top: var(--space-2);
}

.content__section-title {
  margin: 0 0 var(--space-4);
  font-size: var(--fs-h4);
  font-weight: 600;
  color: var(--ecc-text);
  letter-spacing: -0.01em;
}

.content__empty {
  margin: 0;
  padding: var(--space-8);
  border: 1px dashed var(--ecc-border);
  border-radius: var(--radius-lg);
  text-align: center;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body);
  background: var(--ecc-surface-1);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-10) var(--space-8);
  border: 1px dashed var(--ecc-border);
  border-radius: var(--radius-lg);
  text-align: center;
  background: var(--ecc-surface-1);
  margin-top: var(--space-4);
}

.empty-state__icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: var(--radius-full);
  background: var(--ecc-primary-soft);
  color: #a5b4fc;
  margin-bottom: var(--space-1);
}

.empty-state__title {
  margin: 0;
  font-size: var(--fs-h4);
  font-weight: 600;
  color: var(--ecc-text);
}

.empty-state__desc {
  margin: 0;
  font-size: var(--fs-body);
  color: var(--ecc-text-muted);
  max-width: 360px;
  line-height: 1.55;
}

.empty-state__action {
  margin-top: var(--space-3);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-4);
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-5);
  background: var(--ecc-surface-1);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-lg);
  transition: border-color var(--t-fast), transform var(--t-fast);
}

.stat-card:hover {
  border-color: var(--ecc-border);
  transform: translateY(-1px);
}

.stat-card__label {
  font-size: var(--fs-caption);
  color: var(--ecc-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.7px;
  font-weight: 600;
}

.stat-card__value {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--ecc-text);
  letter-spacing: -0.025em;
  margin-top: var(--space-1);
}

.stat-card__hint {
  font-size: var(--fs-small);
  color: #6ee7b7;
  font-weight: 500;
}

.page-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}

.page-toolbar__search {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex: 1;
  max-width: 340px;
  padding: 9px 12px;
  background: var(--ecc-surface-1);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-sm);
  color: var(--ecc-text-muted);
  transition: border-color var(--t-fast), background var(--t-fast);
}

.page-toolbar__search:focus-within {
  border-color: var(--ecc-primary);
  background: var(--ecc-surface-2);
}

.page-toolbar__search input {
  background: none;
  border: none;
  outline: none;
  color: var(--ecc-text);
  font-size: var(--fs-body);
  font-family: inherit;
  flex: 1;
  min-width: 0;
}

.page-toolbar__search input::placeholder {
  color: var(--ecc-text-subtle);
}

.table-wrap {
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--ecc-surface-1);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-body);
}

.data-table thead th {
  text-align: left;
  padding: 12px var(--space-4);
  font-size: var(--fs-caption);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--ecc-text-muted);
  background: var(--ecc-surface-2);
  border-bottom: 1px solid var(--ecc-border-subtle);
  user-select: none;
}

.data-table tbody td {
  padding: 14px var(--space-4);
  border-bottom: 1px solid var(--ecc-border-subtle);
  color: var(--ecc-text);
  vertical-align: middle;
}

.data-table tbody tr:last-child td {
  border-bottom: none;
}

.contact-row {
  transition: background var(--t-fast);
  cursor: pointer;
}

.contact-row:hover {
  background: var(--ecc-surface-2);
}

.contact-name-cell {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.contact-avatar {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #6366f1, #06b6d4);
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 11.5px;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(99, 102, 241, 0.25);
}

.contact-name-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 1px;
}

.contact-name {
  font-weight: 600;
  font-size: var(--fs-body);
  color: var(--ecc-text);
}

.contact-email {
  font-size: var(--fs-small);
  color: var(--ecc-text-muted);
}

.contact-date {
  color: var(--ecc-text-muted);
  font-size: var(--fs-small);
  font-variant-numeric: tabular-nums;
}

.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: var(--fs-caption);
  font-weight: 600;
  letter-spacing: 0.2px;
  border: 1px solid transparent;
  white-space: nowrap;
}

.badge--customer {
  background: var(--ecc-success-soft);
  border-color: rgba(16, 185, 129, 0.3);
  color: #6ee7b7;
}

.badge--qualified {
  background: var(--ecc-primary-soft);
  border-color: rgba(99, 102, 241, 0.35);
  color: #a5b4fc;
}

.badge--proposal {
  background: var(--ecc-accent-soft);
  border-color: rgba(6, 182, 212, 0.3);
  color: #67e8f9;
}

.badge--lead {
  background: rgba(139, 149, 176, 0.1);
  border-color: rgba(139, 149, 176, 0.25);
  color: var(--ecc-text-muted);
}

.table-footnote {
  margin-top: var(--space-3);
  font-size: var(--fs-small);
  color: var(--ecc-text-muted);
  font-variant-numeric: tabular-nums;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(3, 6, 12, 0.75);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
  z-index: 100;
  animation: modal-fade-in 0.15s ease;
}

@keyframes modal-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal {
  width: 100%;
  max-width: 460px;
  background: var(--ecc-surface-1);
  border: 1px solid var(--ecc-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xl);
  padding: var(--space-6);
  animation: modal-pop-in 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
}

@keyframes modal-pop-in {
  from {
    opacity: 0;
    transform: scale(0.96) translateY(-6px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-5);
}

.modal__title {
  margin: 0;
  font-size: var(--fs-h3);
  font-weight: 600;
  letter-spacing: -0.02em;
}

.modal__close {
  background: none;
  border: none;
  color: var(--ecc-text-muted);
  cursor: pointer;
  padding: 6px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  transition: color var(--t-fast), background var(--t-fast);
}

.modal__close:hover {
  color: var(--ecc-text);
  background: rgba(255, 255, 255, 0.05);
}

.modal__actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-6);
}

.modal__confirm {
  padding: var(--space-1) 0 0;
}

.modal__confirm-text {
  margin: 0 0 var(--space-5);
  color: var(--ecc-text);
  font-size: var(--fs-body-lg);
  line-height: 1.55;
}

.ecc-field__label {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ecc-text-muted);
  font-weight: 600;
  letter-spacing: 0.4px;
  margin-bottom: var(--space-2);
  text-transform: uppercase;
}

.stage-pills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.stage-pill {
  padding: 8px 14px;
  background: var(--ecc-surface-2);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-full);
  color: var(--ecc-text-muted);
  font-family: inherit;
  font-size: var(--fs-small);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--t-fast);
}

.stage-pill:hover:not(:disabled) {
  color: var(--ecc-text);
  border-color: var(--ecc-border-strong);
}

.stage-pill--active {
  background: var(--ecc-primary-soft);
  border-color: var(--ecc-primary);
  color: #a5b4fc;
}

.stage-pill:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.toast {
  position: fixed;
  bottom: var(--space-6);
  right: var(--space-6);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 12px 18px;
  background: var(--ecc-surface-2);
  border: 1px solid rgba(16, 185, 129, 0.4);
  border-radius: var(--radius);
  color: #6ee7b7;
  font-size: var(--fs-body);
  font-weight: 500;
  box-shadow: var(--shadow-lg);
  z-index: 200;
  animation: toast-slide-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.toast::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  height: 2px;
  background: var(--ecc-success);
  animation: toast-progress 4s linear forwards;
}

@keyframes toast-slide-in {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes toast-progress {
  from {
    width: 100%;
  }
  to {
    width: 0%;
  }
}

.ecc-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-5);
  min-height: 100vh;
  width: 100%;
}

.ecc-loading__spinner {
  width: 36px;
  height: 36px;
  border: 3px solid var(--ecc-border);
  border-top-color: var(--ecc-primary);
  border-radius: 50%;
  animation: ecc-spin 0.8s linear infinite;
}

.ecc-loading__text {
  margin: 0;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body);
  letter-spacing: 0.01em;
}

.ecc-dashboard {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
}

.ecc-mark {
  display: inline-block;
  flex-shrink: 0;
}

.ecc-mark--sm {
  display: inline-block;
  margin-bottom: var(--space-4);
}

.skeleton-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 14px var(--space-4);
  border-bottom: 1px solid var(--ecc-border-subtle);
}

.skeleton-avatar {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-full);
  background: var(--ecc-surface-3);
  animation: skeleton-pulse 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

.skeleton-line {
  height: 10px;
  background: var(--ecc-surface-3);
  border-radius: 5px;
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

.skeleton-line--short { width: 120px; }
.skeleton-line--medium { width: 200px; }
.skeleton-line--long { width: 80%; }

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}


/* ============================================================
   CONTACT DETAIL v2
   ============================================================ */

.detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.detail__back {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 6px 10px 6px 6px;
  border-radius: var(--radius-sm);
  background: none;
  border: none;
  color: var(--ecc-text-muted);
  font-family: inherit;
  font-size: var(--fs-body);
  font-weight: 500;
  cursor: pointer;
  align-self: flex-start;
  transition: color var(--t-fast), background var(--t-fast);
}

.detail__back:hover {
  color: var(--ecc-text);
  background: rgba(255, 255, 255, 0.05);
}

.detail-hero {
  display: flex;
  align-items: flex-start;
  gap: var(--space-5);
  padding: var(--space-6);
  background: var(--ecc-surface-1);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-lg);
}

.detail-hero__avatar {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #6366f1, #06b6d4);
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 26px;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.28);
}

.detail-hero__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.detail-hero__title-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.detail-hero__name {
  margin: 0;
  font-size: 26px;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--ecc-text);
}

.detail-hero__role {
  margin: 0;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body-lg);
}

.detail-hero__contact {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.detail-hero__chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  background: var(--ecc-surface-2);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-full);
  color: var(--ecc-text-muted);
  font-size: var(--fs-small);
  text-decoration: none;
  transition: all var(--t-fast);
}

a.detail-hero__chip:hover {
  color: var(--ecc-text);
  border-color: var(--ecc-border-strong);
}

.detail-hero__actions {
  display: flex;
  gap: var(--space-2);
  flex-shrink: 0;
}

.detail-hero__actions .ecc-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.detail-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-3);
}

@media (max-width: 900px) {
  .detail-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

.detail-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: var(--space-4) var(--space-5);
  background: var(--ecc-surface-1);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-lg);
}

.detail-stat__label {
  font-size: var(--fs-caption);
  color: var(--ecc-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.7px;
  font-weight: 600;
}

.detail-stat__value {
  font-size: var(--fs-h2);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ecc-text);
}

.detail-stat__hint {
  font-size: var(--fs-small);
  color: var(--ecc-text-subtle);
}

.detail__grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: var(--space-5);
  align-items: start;
}

@media (max-width: 900px) {
  .detail__grid {
    grid-template-columns: 1fr;
  }
}

.detail__sidebar,
.detail__main {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  min-width: 0;
}

.detail-card {
  background: var(--ecc-surface-1);
  border: 1px solid var(--ecc-border-subtle);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
}

.detail-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.detail-card__title {
  margin: 0;
  font-size: var(--fs-caption);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--ecc-text-muted);
}

.detail-card__action {
  padding: 5px 12px;
  border-radius: var(--radius-sm);
  background: none;
  border: 1px solid var(--ecc-border-subtle);
  color: var(--ecc-text-muted);
  font-family: inherit;
  font-size: var(--fs-small);
  font-weight: 500;
  cursor: pointer;
  transition: all var(--t-fast);
}

.detail-card__action:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.info-row__icon {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--ecc-surface-2);
  color: var(--ecc-text-muted);
  flex-shrink: 0;
}

.info-row__body {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.info-row__label {
  font-size: var(--fs-caption);
  color: var(--ecc-text-subtle);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 600;
}

.info-row__value {
  font-size: var(--fs-body);
  color: var(--ecc-text);
  font-weight: 500;
  word-break: break-word;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tag {
  padding: 3px 10px;
  background: var(--ecc-primary-soft);
  border: 1px solid rgba(99, 102, 241, 0.3);
  border-radius: var(--radius-full);
  color: #a5b4fc;
  font-size: var(--fs-small);
  font-weight: 500;
}

.detail-notes {
  margin: 0;
  color: var(--ecc-text);
  font-size: var(--fs-body);
  line-height: 1.6;
}

.detail-muted {
  margin: 0;
  color: var(--ecc-text-muted);
  font-size: var(--fs-body);
  line-height: 1.55;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.activity-item {
  display: flex;
  gap: var(--space-3);
  position: relative;
}

.activity-item__marker {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6px;
  background: var(--ecc-primary);
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
}

.activity-item__marker--email {
  background: #6366f1;
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
}

.activity-item__marker--call {
  background: #06b6d4;
  box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.15);
}

.activity-item__marker--meeting {
  background: #10b981;
  box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
}

.activity-item__marker--note {
  background: #f59e0b;
  box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15);
}

.activity-item__body {
  flex: 1;
  min-width: 0;
}

.activity-item__meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: 2px;
}

.activity-item__kind {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--ecc-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.activity-item__time {
  font-size: var(--fs-caption);
  color: var(--ecc-text-subtle);
}

.activity-item__title {
  margin: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ecc-text);
}

.activity-item__text {
  margin: 2px 0 0;
  font-size: var(--fs-body);
  color: var(--ecc-text-muted);
  line-height: 1.5;
}

.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-6);
  border: 1px dashed var(--ecc-border);
  border-radius: var(--radius);
  text-align: center;
  background: var(--ecc-bg);
}

.detail-empty__icon {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  background: var(--ecc-primary-soft);
  color: #a5b4fc;
  margin-bottom: var(--space-1);
}

.detail-empty__title {
  margin: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ecc-text);
}

.detail-empty__desc {
  margin: 0;
  font-size: var(--fs-small);
  color: var(--ecc-text-muted);
  max-width: 320px;
  line-height: 1.5;
}


/* ============================================================
   CONTACT FORM (wide modal)
   ============================================================ */

.modal--wide {
  max-width: 640px;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3) var(--space-4);
}

@media (max-width: 640px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
}

.form-grid .ecc-field {
  margin-bottom: 0;
}

/* ---------- Tags input ---------- */

.ecc-field--tags {
  margin-top: var(--space-3);
}

.tag-input-row {
  display: flex;
  gap: var(--space-2);
}

.tag-input-row input {
  flex: 1;
  padding: 12px 14px;
  background: var(--ecc-surface-1);
  color: var(--ecc-text);
  border: 1px solid var(--ecc-border);
  border-radius: var(--radius);
  font-size: var(--fs-body-lg);
  font-family: inherit;
  outline: none;
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}

.tag-input-row input:focus {
  border-color: var(--ecc-primary);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.tag-add-btn {
  padding: 12px 18px;
  border-radius: var(--radius);
  border: 1px solid var(--ecc-border-strong);
  background: var(--ecc-surface-2);
  color: var(--ecc-text);
  font-family: inherit;
  font-size: var(--fs-body);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--t-fast);
}

.tag-add-btn:hover:not(:disabled) {
  background: var(--ecc-surface-3);
  border-color: var(--ecc-primary);
}

.tag-add-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.tag-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: var(--space-3);
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 4px 4px 12px;
  background: var(--ecc-primary-soft);
  border: 1px solid rgba(99, 102, 241, 0.35);
  border-radius: var(--radius-full);
  color: #a5b4fc;
  font-size: var(--fs-small);
  font-weight: 500;
}

.tag-chip__remove {
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  padding: 0;
  border-radius: 50%;
  border: none;
  background: none;
  color: currentColor;
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
  transition: background var(--t-fast);
}

.tag-chip__remove:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.12);
}

/* ---------- Notes textarea ---------- */

.ecc-field--notes {
  margin-top: var(--space-3);
}

.ecc-field textarea {
  width: 100%;
  padding: 12px 14px;
  background: var(--ecc-surface-1);
  color: var(--ecc-text);
  border: 1px solid var(--ecc-border);
  border-radius: var(--radius);
  font-size: var(--fs-body-lg);
  font-family: inherit;
  outline: none;
  resize: vertical;
  min-height: 90px;
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}

.ecc-field textarea:focus {
  border-color: var(--ecc-primary);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.ecc-field textarea::placeholder {
  color: var(--ecc-text-subtle);
}
